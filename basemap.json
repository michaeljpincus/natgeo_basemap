{
  "version": 8,
  "projection": { "type": "globe" },
  "glyphs": "https://michaeljpincus.github.io/natgeo_basemap/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://michaeljpincus.github.io/basemap/sprites/sprite",
  "sources": {
    "terrain": {
      "type": "raster-dem",
      "tiles": ["https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxzoom": 15,
      "attribution": "Basemap by Michael Pincus. Terrain: Mapzen/AWS Terrain Tiles"
    },
    "base": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "&copy; <a href=\"https://openfreemap.org\">OpenFreeMap</a> &copy; OpenMapTiles, data &copy; OpenStreetMap contributors"
    },
    "adm1-borders": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/stateborders.geojson",
      "generateId": true
    },
    "uk-borders": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/uk_borders.geojson",
      "generateId": true
    },
    "extra-adm1-labels": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/extra-adm1.geojson",
      "generateId": true
    },
    "extra-country-labels": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/extra-country-labels.geojson",
      "generateId": true
    },
    "territory-labels": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/territories.geojson"
    },
    "uk-label": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/uk.geojson"
    },
    "westbank": {
      "type": "geojson",
      "data": "https://michaeljpincus.github.io/basemap/westbank.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#fcfaf5" }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "terrain",
      "paint": {
        "hillshade-exaggeration": ["interpolate", ["linear"], ["zoom"], 3, 0.25, 8, 0.35, 12, 0.35],
        "hillshade-shadow-color": "#9c9891",
        "hillshade-highlight-color": "#fcfaf5",
        "hillshade-accent-color": "hsl(210, 8%, 78%)",
        "hillshade-illumination-direction": 315
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "base",
      "source-layer": "water",
      "paint": { "fill-color": "#def1fc" }
    },

    {
      "id": "ocean-tint",
      "type": "color-relief",
      "source": "terrain",
      "paint": {
        "color-relief-color": [
          "interpolate", ["linear"], ["elevation"],
          -6000, "hsla(208, 55%, 62%, 0.28)",
          -3000, "hsla(207, 60%, 70%, 0.22)",
          -1000, "hsla(206, 65%, 78%, 0.17)",
          -200,  "hsla(205, 70%, 85%, 0.11)",
          -1,    "hsla(204, 77%, 90%, 0.05)",
          0,     "hsla(204, 77%, 93%, 0)"
        ]
      }
    },
    {
      "id": "urban-areas",
      "type": "fill",
      "source": "base",
      "source-layer": "landuse",
      "minzoom": 6,
      "paint": {
        "fill-color": "#f5f1e6",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.9, 12, 0.6, 15, 0.3]
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "base",
      "source-layer": "waterway",
      "minzoom": 7,
      "paint": {
        "line-color": "#def1fc",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 12, 1.5]
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "base",
      "source-layer": "park",
      "filter": [
        "all",
        ["==", "$type", "Polygon"],
        ["in", ["get", "class"], ["literal", ["national_park", "state_park"]]]
      ],
      "paint": {
        "fill-color": "#e4efdc",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "country-borders",
      "type": "line",
      "source": "base",
      "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["==", ["get", "maritime"], 0]],
      "paint": {
        "line-color": "black",
        "line-width": 0.5
      }
    },
    {
      "id": "uk-borders",
      "type": "line",
      "source": "uk-borders",
      "minzoom": 4,
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#575757",
        "line-width": 1,
        "line-dasharray": [0, 3]
      }
    },
    {
      "id": "adm1-borders",
      "type": "line",
      "source": "adm1-borders",
      "minzoom": 4,
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#515050",
        "line-width": 0.8,
        "line-dasharray": [0, 3]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "base",
      "source-layer": "transportation",
      "minzoom": 1,
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]],
      "paint": {
        "line-color": "#e3e3e3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.3, 10, 1]
      }
    },
    {
      "id": "streets-minor",
      "type": "line",
      "source": "base",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary", "minor"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d9d9d9",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 0.4, 16, 3, 20, 14]
      }
    },
    {
      "id": "streets-service",
      "type": "line",
      "source": "base",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": ["==", ["get", "class"], "service"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e6e6e6",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 15, 0.5, 20, 6]
      }
    },
    {
      "id": "country-borders2",
      "type": "line",
      "source": "base",
      "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["==", ["get", "maritime"], 0]],
      "paint": {
        "line-color": "black",
        "line-width": 0.5
      }
    },
    {
      "id": "adm1-borders2",
      "type": "line",
      "source": "adm1-borders",
      "minzoom": 4,
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#515050",
        "line-width": 0.8,
        "line-dasharray": [0, 3]
      }
    },
    {
      "id": "ocean-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "water_name",
      "filter": ["==", ["get", "class"], "ocean"],
      "minzoom": 0,
      "maxzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Fraunces 72pt Bold Italic"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.3,
        "text-size": ["interpolate", ["linear"], ["zoom"], 1, 14, 3, 20, 6, 28],
        "text-max-width": 8,
        "text-padding": 10
      },
      "paint": {
        "text-color": "#4a90c2",
        "text-halo-color": "hsla(204, 77%, 93%, 0.6)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "sea-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "water_name",
      "filter": ["==", ["get", "class"], "sea"],
      "minzoom": 3,
      "maxzoom": 10,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Fraunces 72pt Bold Italic"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.2,
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 12, 6, 17, 10, 22],
        "text-max-width": 7,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#4a90c2",
        "text-halo-color": "hsla(204, 77%, 93%, 0.6)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "lake-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "water_name",
      "filter": ["==", ["get", "class"], "lake"],
      "minzoom": 5,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Fraunces 72pt Bold Italic"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15,
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 9, 13, 14, 17],
        "text-max-width": 6,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99]
      },
      "paint": {
        "text-color": "#5b9fcf",
        "text-halo-color": "hsla(0, 0%, 100%, 0.6)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "river-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "waterway",
      "filter": ["in", ["get", "class"], ["literal", ["river", "canal"]]],
      "minzoom": 8,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Fraunces 72pt Bold Italic"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12,
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 14, 14],
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#5b9fcf",
        "text-halo-color": "hsla(0, 0%, 100%, 0.6)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "neighborhoods",
      "type": "symbol",
      "source": "base",
      "source-layer": "place",
      "minzoom": 7,
      "filter": ["in", ["get", "class"], ["literal", ["suburb", "quarter", "neighbourhood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Galdeano Regular"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1,
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 13, 15, 16],
        "text-max-width": 6,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99]
      },
      "paint": {
        "text-color": "hsla(0, 0%, 25%, 0.7)",
        "text-halo-color": "hsla(0, 0%, 100%, 0.7)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "city-dots",
      "type": "circle",
      "source": "base",
      "source-layer": "place",
      "filter": ["all",
        ["in", ["get", "class"], ["literal", ["city", "town"]]],
        ["!=", ["get", "capital"], 2]
      ],
      "minzoom": 3,
      "maxzoom": 9,
      "paint": {
        "circle-color": "#000000",
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 4, 1.5, 8, 2.5, 12, 3],
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 0.75
      }
    },
    {
      "id": "cities",
      "type": "symbol",
      "source": "base",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
      "minzoom": 3,
      "maxzoom": 14,
      "layout": {
        "icon-image": ["case", ["==", ["get", "capital"], 2], "star", ""],
        "icon-size": ["interpolate", ["linear"], ["zoom"], 4, 0.5, 8, 0.7, 9, 0.7, 9.01, 0],
        "icon-optional": true,
        "text-optional": true,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Amarna Bold"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          4,  ["interpolate", ["linear"], ["coalesce", ["get", "rank"], 99], 1, 15, 8, 10],
          8,  ["interpolate", ["linear"], ["coalesce", ["get", "rank"], 99], 1, 19, 8, 12],
          12, ["interpolate", ["linear"], ["coalesce", ["get", "rank"], 99], 1, 22, 8, 14]
        ],
        "text-variable-anchor": ["top", "bottom", "left", "right"],
        "text-radial-offset": ["case", ["==", ["get", "capital"], 2], 0.8, 0.5],
        "symbol-sort-key": ["coalesce", ["get", "rank"], 99]
      },
      "paint": {
        "text-color": "hsla(0, 0%, 10%, 0.85)",
        "text-halo-color": "hsla(0, 0%, 100%, 0.7)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "adm1",
      "type": "symbol",
      "source": "base",
      "source-layer": "place",
      "filter": [
        "all",
        ["!=", ["coalesce", ["get", "name:en"], ["get", "name"]], "Amazonas"],
